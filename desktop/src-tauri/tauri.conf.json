{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coder",
  "version": "0.1.0",
  "identifier": "com.apple.coder",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir .. build:frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Coder",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 750,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
